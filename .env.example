# Copy this file to .env.local for local development.
# Use a staging Supabase project locally. Never commit real keys.
# Service role keys must never appear in this repo or in NEXT_PUBLIC_* vars.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional UI label only: local | staging | production
NEXT_PUBLIC_APP_ENV=local
