# Copy this file to .env.local for local development.
# Use the staging Supabase project locally. Never commit real keys.
# Service role keys must never appear in this repo or in NEXT_PUBLIC_* vars.
#
# Staging project URL (public): https://ffksqfgscuezjwdbktcd.supabase.co
# Anon / publishable key: Dashboard → Project Settings → API Keys (not the service role).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional UI label only: local | staging | production
NEXT_PUBLIC_APP_ENV=local

# Public site origin for LINE-group signup links (no trailing slash).
# Example placeholder: https://YOUR_APP_HOST
NEXT_PUBLIC_APP_URL=

# Parent-facing bank transfer instructions. Never put a real account number in git.
# Admins can also save this in the in-app club_runtime_settings field (not git).
# Real values belong in local .env.local / host secrets / the admin UI.
BANK_TRANSFER_HINT=
