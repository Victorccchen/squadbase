# Copy this file to .env.local for local development.
# Use the staging Supabase project locally. Never commit real keys.
# Service role keys must never appear in this repo or in NEXT_PUBLIC_* vars.
#
# Staging project URL (public): https://ffksqfgscuezjwdbktcd.supabase.co
# Anon / publishable key: Dashboard → Project Settings → API Keys (not the service role).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional UI label only: local | staging | production
NEXT_PUBLIC_APP_ENV=local

# Public site origin for LINE-group signup links (no trailing slash).
# Example placeholder: https://YOUR_APP_HOST
NEXT_PUBLIC_APP_URL=

# Parent-facing bank transfer instructions. Never put a real account number in git.
# Admins can also save this in the in-app club_runtime_settings field (not git).
# Real values belong in local .env.local / host secrets / the admin UI.
BANK_TRANSFER_HINT=

# Staging roster seed CLI only (scripts/seed-torneopal-roster.ts). Never NEXT_PUBLIC_*.
# Dashboard → Project Settings → API Keys → service_role. Do not commit the value.
# SUPABASE_SERVICE_ROLE_KEY=

# Stage Notif Web Push (VAPID). Generate locally; never commit real keys.
# npx web-push generate-vapid-keys
# Public key is safe in NEXT_PUBLIC_* (browser subscribe). Private key is server-only.
# Apply on Vercel squadbase-staging only. Do not set these on a production project
# until Victor confirms production send.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:staging-push@localhost
